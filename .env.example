# Oura OAuth2 — register an application at https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=your_oura_client_id_here
OURA_CLIENT_SECRET=your_oura_client_secret_here
OURA_REDIRECT_URI=http://localhost:8080/callback

# USDA FoodData Central — free key from https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=your_usda_api_key_here

# Withings OAuth2 — register an application at https://developer.withings.com/
# The redirect URI must be HTTPS, public, registered in the Withings app, and end with /callback.
WITHINGS_CLIENT_ID=your_withings_client_id_here
WITHINGS_CLIENT_SECRET=your_withings_client_secret_here
WITHINGS_REDIRECT_URI=https://your-public-host.example/callback
WITHINGS_API_BASE=https://wbsapi.withings.net

# IANA timezone name (e.g. America/Toronto, Europe/London, Asia/Tokyo)
TIMEZONE=America/Toronto

# Display name shown in the dashboard header
DISPLAY_NAME=Your Name

# Optional test/development overrides. Leave unset for normal use.
# HEALTH_DB_PATH=/tmp/h_tracker_test.db
# PROFILE_PATH=/tmp/PROFILE.md
